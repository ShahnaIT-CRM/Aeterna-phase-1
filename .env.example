# Local development only (copy to backend/.env or export in your shell)
DEBUG=1
SECRET_KEY=change-me
# DATABASE_URL=postgresql://user:pass@localhost:5432/aeterna   # leave unset to use SQLite locally

# Email (console backend by default; messages print to the server log)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=Aeterna <no-reply@yourdomain.com>
# SITE_URL=https://your-app.up.railway.app   # used for links inside emails

# Phase 4 PKI: Fernet key(s) that encrypt university signing keys at rest. REQUIRED in production.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# To rotate: put the new key first, keep the old one after a comma, then remove it once nothing needs it.
PKI_MASTER_KEYS=
